{
  "name": "growi-plugin-print-layout",
  "version": "0.1.0",
  "description": "A GROWI plugin to adjust the print layout of a page (paper size, margins, image width, page breaks, two-column ratio).",
  "license": "MIT",
  "type": "module",
  "keywords": ["growi", "growi-plugin"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@growi/pluginkit": "1.2.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "growiPlugin": {
    "schemaVersion": "4",
    "types": ["script"]
  }
}
